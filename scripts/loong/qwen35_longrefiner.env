RUN_NAME=qwen35_27b_longrefiner

# Loong input/output.
LONGREFINER_INPUT_PATH=/workspace/rag/Loong/loong_process.jsonl
LONGREFINER_OUTPUT_DIR=/workspace/rag/LongRefiner/outputs/loong

# Qwen3.5-27B generation endpoint.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen3.5-27B
LLM_TEMPERATURE=0
LLM_TOP_P=0.95
LLM_MAX_NEW_TOKENS=4096
OPENAI_MAX_INPUT_TOKENS=32768
DISABLE_THINKING=1
TRUST_REMOTE_CODE=1

# LongRefiner modules from the README.
LONGREFINER_VLLM_ROOT=/workspace/vllm-qwen35-cu128
LONGREFINER_BASE_MODEL_PATH=Qwen/Qwen2.5-3B-Instruct
LONGREFINER_QUERY_ANALYSIS_LORA_PATH=jinjiajie/Query-Analysis-Qwen2.5-3B-Instruct
LONGREFINER_DOC_STRUCTURING_LORA_PATH=jinjiajie/Doc-Structuring-Qwen2.5-3B-Instruct
LONGREFINER_GLOBAL_SELECTION_LORA_PATH=jinjiajie/Global-Selection-Qwen2.5-3B-Instruct
LONGREFINER_SCORE_MODEL_NAME=bge-reranker-v2-m3
LONGREFINER_SCORE_MODEL_PATH=BAAI/bge-reranker-v2-m3
LONGREFINER_MAX_MODEL_LEN=25000
LONGREFINER_TENSOR_PARALLEL_SIZE=1
LONGREFINER_GPU_MEMORY_UTILIZATION=0.70
LONGREFINER_DTYPE=auto
LONGREFINER_ENFORCE_EAGER=0
LONGREFINER_BUDGET=2048
LONGREFINER_QUIET=1

REQUEST_TIMEOUT_SECONDS=3600

# qwen3.5-27B vLLM server. On this 4-GPU box, Qwen uses all 4 GPUs and
# LongRefiner shares physical GPU 0. Keep Qwen's memory utilization conservative
# so the 3B LongRefiner model and reranker can fit on the same GPU.
VLLM_CUDA_VISIBLE_DEVICES=0,1,2,3
LONGREFINER_CUDA_VISIBLE_DEVICES=0

VLLM_PYTHON=/opt/conda/bin/python
LONGREFINER_PYTHON=/opt/conda/bin/python
PYTHONPATH=/workspace/vllm-qwen35-cu128:${PYTHONPATH:-}
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
VLLM_MODEL=Qwen/Qwen3.5-27B
VLLM_SERVED_MODEL_NAME=Qwen/Qwen3.5-27B
VLLM_TENSOR_PARALLEL_SIZE=4
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.60
VLLM_MAX_NUM_SEQS=1
VLLM_HEALTH_TIMEOUT=3600
VLLM_TRUST_REMOTE_CODE=1
VLLM_REASONING_PARSER=
VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
VLLM_MODEL_IMPL=
VLLM_ENFORCE_EAGER=1
FLASHINFER_DISABLE_VERSION_CHECK=1
